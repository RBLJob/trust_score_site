<!DOCTYPE html>
<html>
<head>
    <title>Partners Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        h1 {
            text-align: center;
            color: #0A152C;
            margin-bottom: 30px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
            font-size: 10px;
        }
        th {
            background-color: #0A152C;
            color: white;
            font-weight: bold;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            font-size: 12px;
            color: #666;
        }
    </style>
</head>
<body>
    <h1>Partners Report</h1>
    <table>
        <thead>
            <tr>
                <th>Partner Name</th>
                <th>Trust Score</th>
                <th>Avg. Ahrefs</th>
                <th>Avg. Moz</th>
                <th>Avg. Semrush</th>
                <th>URL</th>
                <th>Contact</th>
                <th>Industry Vertical</th>
                <th>Business Model</th>
                <th>Company Vertical</th>
                <th>RBL Brand</th>
            </tr>
        </thead>
        <tbody>
            {% for publisher in publishers %}
            <tr>
                <td>{{ publisher['Partner Name'] }}</td>
                <td>{{ publisher['Trust Score'] }}</td>
                <td>{{ publisher['Avg. Ahrefs'] }}</td>
                <td>{{ publisher['Avg. Moz'] }}</td>
                <td>{{ publisher['Avg. Semrush'] }}</td>
                <td>{{ publisher['URL'] }}</td>
                <td>{{ publisher['Contact'] }}</td>
                <td>{{ publisher['Industry Vertical'] }}</td>
                <td>{{ publisher['Business Model'] }}</td>
                <td>{{ publisher['Company Vertical'] }}</td>
                <td>{{ publisher['RBL Brand'] }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="footer">
        Generated on {{ moment().format('MMMM Do YYYY, h:mm:ss a') }}
    </div>
</body>
</html>